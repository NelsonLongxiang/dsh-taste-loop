{
  "name": "@nelsonlongxiang/dsh-taste-loop",
  "version": "0.2.1",
  "description": "Taste-loop DSH plugin (host-only): taste_rules/case/record/queue/update tools + taste-mcp HTTP hosting. Self-service versioned taste rules with independent-session quorum and human arbitration. 品味闭环插件：自助版本化规则提案+独立共识+人工仲裁。",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "README_zh.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NelsonLongxiang/dsh-taste-loop.git"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepare": "pnpm build",
    "verify": "tsc -p tsconfig.json --noEmit && node --test test/core.test.mjs",
    "drift": "node scripts/check-drift.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.5",
    "ygl-trees": "0.114.9"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.5",
    "@deepseek-ai/dsh-tools": ">=0.2.1-rc.2",
    "@deepseek-ai/dsh-agent": ">=0.2.1-rc.2"
  },
  "devDependencies": {
    "typescript": "^5.7.0",
    "@types/node": "^22.0.0"
  },
  "license": "MIT"
}
